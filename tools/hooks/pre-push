#!/bin/sh
# Purpose: run the project's own tests before a push to a protected branch,
# through the acceptance gate, so a push that would fail the CI gate there
# is stopped on this machine.
# Entry points: git runs this before every push once hooksPath points here;
# install writes it when no CI runs the gate, or when asked with --pre-push.
# Invariants: hands git's ref lines on stdin to `gate --pre-push`, which
# gates only a ref updating a branch in test.pre_push_branches (default
# main and master), judges it by the test settings at the destination's
# current commit (HEAD's for a new branch), refuses one whose commit tree
# differs from the checked-out tree before any test runs, and reuses the
# last local run when it covers that tree or only docs_only files changed
# since; a push of other branches or of deletions runs no tests; exit 0 lets
# the push through, anything else stops it with the gate's message.
# Never change without a decision: which command runs here.
root=$(git rev-parse --show-toplevel) || exit 1
py=$(command -v python3 || command -v python) || {
    echo "themis: needs python 3.9+ on PATH"
    exit 1
}
exec "$py" "$root/tools/themis.py" gate --pre-push
